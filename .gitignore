# Ignore folders generated by Bundler
.bundle/
vendor/

# Gemfile.lock is platform-specific (locked to whatever OS ran `bundle install`
# last); committing one broke CI when it was locked to Windows but CI runs on
# Linux. Let ruby/setup-ruby resolve + cache its own lockfile per-platform.
Gemfile.lock
